pkgbase = flamewm-git
	pkgdesc = a wayland compositor as light as it gets, no features sacrificed, with its own independent X server written from scratch
	pkgver = r284.c633eed
	pkgrel = 1
	url = https://github.com/haiderking1/flamewm
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = clang
	makedepends = make
	makedepends = pkgconf
	makedepends = wayland-protocols
	makedepends = vulkan-headers
	makedepends = shaderc
	makedepends = wlroots0.20
	makedepends = wayland
	makedepends = libxkbcommon
	makedepends = libglvnd
	makedepends = libdrm
	makedepends = libxshmfence
	makedepends = lua54
	makedepends = pango
	makedepends = cairo
	makedepends = pixman
	makedepends = harfbuzz
	makedepends = glib2
	makedepends = libpipewire
	makedepends = systemd-libs
	makedepends = libjpeg-turbo
	makedepends = libpng
	makedepends = libwebp
	makedepends = ffmpeg
	makedepends = librsvg
	makedepends = gdk-pixbuf2
	makedepends = libass
	makedepends = uchardet
	makedepends = mesa
	makedepends = libpulse
	makedepends = curl
	makedepends = pam
	source = flamewm-git::git+https://github.com/haiderking1/flamewm.git
	sha256sums = SKIP

pkgname = flamewm-git
	pkgdesc = a wayland compositor as light as it gets, with its own independent X server written from scratch (flame alone, no apps)
	depends = wlroots0.20
	depends = wayland
	depends = libxkbcommon
	depends = libglvnd
	depends = libdrm
	depends = libxshmfence
	depends = lua54
	depends = pango
	depends = cairo
	depends = pixman
	depends = harfbuzz
	depends = glib2
	depends = libpipewire
	depends = systemd-libs
	depends = libjpeg-turbo
	depends = libpng
	depends = libwebp
	depends = xdg-desktop-portal
	depends = xdg-desktop-portal-gtk
	optdepends = flame-apps-git: the bar, files, player, search, lock and login screens
	optdepends = foot: the terminal super+enter opens
	optdepends = swaylock: a locker if you skip flame-apps-git (set lock = "swaylock")
	provides = flamewm
	conflicts = flamewm

pkgname = flame-apps-git
	pkgdesc = flame's apps: the bar, files, the player, search, the lock and login screens
	depends = flamewm-git
	depends = wayland
	depends = libxkbcommon
	depends = libjpeg-turbo
	depends = libwebp
	depends = ffmpeg
	depends = librsvg
	depends = gdk-pixbuf2
	depends = pango
	depends = cairo
	depends = harfbuzz
	depends = libpng
	depends = glib2
	depends = libpipewire
	depends = libass
	depends = uchardet
	depends = mesa
	depends = libpulse
	depends = systemd-libs
	depends = curl
	depends = pam
	optdepends = greetd: to use flamegreet as the login screen
	provides = flame-apps
	conflicts = flame-apps
	backup = etc/pam.d/flamelock
	backup = etc/xdg/xdg-desktop-portal/flamewm-portals.conf
