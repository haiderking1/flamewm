#!/bin/sh
# flame-update: installs flame on arch, or brings it up to date. it builds
# the packages from dist/aur (makepkg) and installs them with pacman, so
# pacman knows every file. after the first time it updates what's in
#
# the first time, straight from the web:
#   curl -fsSL https://raw.githubusercontent.com/haiderking1/flamewm/main/dist/flame-update | sh
#   (... | sh -s -- --core for flame alone)
#
#   flame-update           update (the first time: flame and its apps)
#   flame-update --core    flame alone, no apps (removes them if they're in)
#   flame-update --all     flame and its apps
#   flame-update --force   build even when nothing changed
#
# FLAME_REPO: another git repo to build from (a fork, a local clone)
set -eu

repo=${FLAME_REPO:-https://github.com/haiderking1/flamewm.git}
src=${XDG_CACHE_HOME:-$HOME/.cache}/flame-update/flamewm

say() { printf '\033[1;33m::\033[0m %s\n' "$*"; }
# pacman's questions answered from the keyboard, also when this script came
# down a pipe (curl ... | sh): stdin is the script then
answer() {
	# a subshell: a failed redirection would end sh itself
	if [ ! -t 0 ] && (: < /dev/tty) 2> /dev/null; then
		"$@" < /dev/tty
	else
		"$@"
	fi
}
die() { printf '\033[1;31m::\033[0m %s\n' "$*" >&2; exit 1; }

want= force=
for arg in "$@"; do
	case $arg in
	--core) want=core ;;
	--all) want=all ;;
	--force) force=1 ;;
	-h|--help) [ -f "$0" ] && sed -n '2,16s/^# \{0,1\}//p' "$0"; exit 0 ;;
	*) die "what's $arg? see flame-update --help" ;;
	esac
done

[ "$(id -u)" != 0 ] || die "not as root: makepkg won't build as root, it asks for sudo when it installs"
command -v pacman > /dev/null && command -v makepkg > /dev/null || die "this is for arch (pacman and makepkg). anywhere else: make install, see docs/install.md"
# what makepkg builds with, and git: on most arch installs already, put in
# when they aren't (a fresh one)
if ! pacman -Qq base-devel git > /dev/null 2>&1; then
	say "getting what flame builds with first (base-devel, git)"
	sudo -v || die "installing needs sudo"
	answer sudo pacman -S --needed base-devel git
fi

# what's in now decides what gets updated
if [ -z "$want" ]; then
	if pacman -Qq flame-apps-git > /dev/null 2>&1; then
		want=all
	elif pacman -Qq flamewm-git > /dev/null 2>&1; then
		want=core
	else
		want=all
	fi
fi

# flame's source, the newest
if [ -d "$src/.git" ]; then
	say "getting the newest flame"
	git -C "$src" fetch -q origin
	git -C "$src" reset -q --hard origin/HEAD
else
	say "getting flame"
	mkdir -p "$(dirname "$src")"
	git clone -q "$repo" "$src"
fi
head=$(git -C "$src" rev-parse --short=7 HEAD)

# nothing new since the last build: nothing to do
installed=$(pacman -Q flamewm-git 2>/dev/null | awk '{print $2}')
apps=$(pacman -Q flame-apps-git 2>/dev/null | awk '{print $2}')
case "$installed" in *".$head-"*)
	if [ -z "$force" ] && { { [ "$want" = core ] && [ -z "$apps" ]; } \
			|| { [ "$want" = all ] && [ -n "$apps" ]; }; }; then
		say "flame's up to date ($head)"
		exit 0
	fi
esac

# the password now, where it shows: makepkg asks for missing deps later,
# into its log
sudo -v || die "installing needs sudo"

# build both in a copy of the PKGBUILD, from the source we just got (no
# second download)
say "building flame ($head)"
build=$(mktemp -d)
trap 'rm -rf "$build"' EXIT
cp "$src/dist/aur/flamewm-git/PKGBUILD" "$build/"
sed -i "s|^source=.*|source=(\"\$pkgbase::git+file://$src\")|" "$build/PKGBUILD"
(cd "$build" && makepkg -s --noconfirm --needed > "$build/makepkg.log" 2>&1) || {
	tail -30 "$build/makepkg.log" >&2
	die "the build failed, the end of its log is above"
}

say "installing"
if [ "$want" = all ]; then
	answer sudo pacman -U --needed "$build"/flamewm-git-*.pkg.tar.zst \
		"$build"/flame-apps-git-*.pkg.tar.zst
else
	answer sudo pacman -U --needed "$build"/flamewm-git-*.pkg.tar.zst
	if [ -n "$apps" ]; then
		say "taking flame's apps out (--core)"
		answer sudo pacman -R flame-apps-git
	fi
fi

say "done: flame $head. log out and back in to run it"
