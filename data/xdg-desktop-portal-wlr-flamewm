# xdg-desktop-portal-wlr on flame (XDG_CURRENT_DESKTOP=flamewm): what to share
# is picked in flame's own picker, on the windows themselves. as a dmenu
# chooser flamectl hears what the app asked for (a screen, a window, either)
# and the picker offers just that, a screen asked for on one screen needs no
# picking at all. the pick goes back as the portal's own line for it.
# make install puts this in /etc/xdg/xdg-desktop-portal-wlr/flamewm, a copy
# in ~/.config/xdg-desktop-portal-wlr/flamewm wins over it
[screencast]
chooser_type=dmenu
chooser_cmd=flamectl share-pick --dmenu
