# xdg-desktop-portal-wlr on flame (XDG_CURRENT_DESKTOP=flamewm): what to share
# is picked in flame's own picker, on the windows themselves.
# flamectl prints the pick the way the portal reads it ("Monitor: NAME",
# "Window: ID"), nothing when cancelled. make install puts this in
# /etc/xdg/xdg-desktop-portal-wlr/flamewm, a copy in
# ~/.config/xdg-desktop-portal-wlr/flamewm wins over it
[screencast]
chooser_type=simple
chooser_cmd=flamectl share-pick
